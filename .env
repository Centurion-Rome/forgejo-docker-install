# Database
DB_PASSWD=change-me
POSTGRES_DB=change-me
POSTGRES_USER=change-me

# Server
SERVER_NAME=192.168.10.93
ROOT_URL=http://192.168.10.93:3000/

# Forgejo
DISABLE_REGISTRATION=false

# Timezone (containers run UTC without this)
TZ=Europe/Berlin

# Mail (SMTP) - required for password resets and notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=forgejo@example.com
SMTP_USER=forgejo@example.com
SMTP_PASS=change-me
